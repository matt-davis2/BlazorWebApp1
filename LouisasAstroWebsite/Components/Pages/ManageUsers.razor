@page "/manageusers"
@using MongoDB.Bson

<PageTitle>Manage Users</PageTitle>

<h3>Manage Users</h3>

<!-- Add/Edit User Form -->
<div class="mb-3">
    <div class="input-group">
        <input @bind="CurrentUser.FirstName" class="form-control" placeholder="First Name" />
        <input @bind="CurrentUser.LastName" class="form-control ms-2" placeholder="Last Name" style="max-width: 150px;" />
        <input @bind="CurrentUser.Email" type="email" class="form-control ms-2" placeholder="Email" style="max-width: 200px;" />
        <button @onclick="SaveUser" class="btn btn-primary ms-2">
            @(EditingUserId == null ? "Add User" : "Save Changes")
        </button>
        @if (EditingUserId != null)
        {
            <button @onclick="CancelEdit" class="btn btn-secondary ms-2">Cancel</button>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger mt-2">@ErrorMessage</div>
    }
</div>

<!-- User List -->
@if (Users == null)
{
    <p>Loading...</p>
}
else if (Users.Count == 0)
{
    <p>No users found.</p>
}
else
{
    <ul class="list-group">
        @foreach (var user in Users)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                User #@user.Id.ToString().Substring(0, 8) - @user.FirstName @user.LastName
                <div>
                    <button @onclick="() => EditUser(user)" class="btn btn-warning btn-sm me-2">Edit</button>
                    <button @onclick="() => DeleteUser(user.Id)" class="btn btn-danger btn-sm">Delete</button>
                </div>
            </li>
        }
    </ul>
}

@code {
    [Inject]
    public UserService UserService { get; set; } = default!; // Nullable with ! for DI

    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!; // Nullable with ! for DI

    private List<User> Users = new List<User>(); // Initialize to avoid CS8618
    private User CurrentUser = new User(); // Initialize
    // REMOVED: private User EditingUser = null; // No longer needed
    private string ErrorMessage = string.Empty; // Initialize
    
    // Keep this for tracking edits
    private ObjectId? EditingUserId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        Users = await UserService.GetUsersAsync() ?? new List<User>();
        StateHasChanged();
    }

    private void EditUser(User user)
    {
        EditingUserId = user.Id; // Track which user we're editing
    
        // Populate form with user data
        CurrentUser = new User
        {
            Id = user.Id,
            FirstName = user.FirstName ?? string.Empty,
            LastName = user.LastName ?? string.Empty,
            Email = user.Email ?? string.Empty,
            PasswordHash = user.PasswordHash ?? string.Empty,
            IsActive = user.IsActive,
            Preferences = user.Preferences
        };
    
        ErrorMessage = string.Empty;
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(CurrentUser.FirstName))
        {
            ErrorMessage = "Name is required.";
            return;
        }

        try
        {
            if (EditingUserId == null || EditingUserId == ObjectId.Empty)
            {
                // Add new user
                var newUser = new User
                {
                    FirstName = CurrentUser.FirstName,
                    LastName = CurrentUser.LastName ?? string.Empty,
                    Email = string.IsNullOrWhiteSpace(CurrentUser.Email) 
                        ? $"{CurrentUser.FirstName.ToLower()}@example.com"
                        : CurrentUser.Email,
                    PasswordHash = CurrentUser.PasswordHash ?? string.Empty, // This is fine (string is reference type)
                    IsActive = CurrentUser.IsActive, // Remove ?? - bool can't be null
                    Preferences = CurrentUser.Preferences
                };
                await UserService.CreateUserAsync(newUser);
            }
            else
            {
                // Update existing user
                CurrentUser.Id = EditingUserId.Value;
                await UserService.UpdateUserAsync(EditingUserId.Value, CurrentUser);
            }

            CancelEdit();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error saving user: {ex.Message}";
        }
    }

    private void CancelEdit()
    {
        EditingUserId = null;
        CurrentUser = new User(); // Reset form
        ErrorMessage = string.Empty;
    }

    private async Task DeleteUser(ObjectId id)
    {
        await UserService.DeleteUserAsync(id);
        await LoadUsers();
    }
}